from fastapi import FastAPI, HTTPException, status
from pydantic import BaseModel, EmailStr

app = FastAPI(title="흉부 X-Ray AI 서비스 User API")

# ==============================================================================
# 1. 가짜 데이터베이스 (메모리 딕셔너리)
# ==============================================================================
# user_id 번호를 key로 사용하는 유저 목록
users_db = {
    1: {
        "id": 1,
        "email": "admin@hospital.com",
        "password": "adminpassword",
        "name": "어드민관리자",
        "department": "개발",
        "gender": "M",
        "phone_number": "010-0000-0000",
        "role": "어드민",
        "is_active": True,
    }
}
next_user_id = 2  # 다음 회원 번호


# ==============================================================================
# 2. Pydantic 스키마 (데이터 규격)
# ==============================================================================

# [1] 회원가입 요청 규격
class SignupRequest(BaseModel):
    email: EmailStr
    password: str
    name: str
    department: str  # 연구, 의료, 개발
    gender: str      # M, F
    phone_number: str

# [2] 로그인 요청 규격
class LoginRequest(BaseModel):
    email: EmailStr
    password: str

# [3] 회원 권한 수정 요청 규격 (어드민용)
class RoleUpdateRequest(BaseModel):
    role: str  # 대기자, 스태프, 어드민

# [4] 회원 정보 수정 요청 규격 (마이페이지용)
class UserUpdateRequest(BaseModel):
    department: str | None = None
    phone_number: str | None = None

# [5] 비밀번호 변경 요청 규격
class PasswordChangeRequest(BaseModel):
    old_password: str
    new_password: str


# ==============================================================================
# 3. API 라우터 (1번 ~ 9번)
# ==============================================================================

# ----------------------------------------------------
# 1. 회원가입 API (REQ-USER-001)
# ----------------------------------------------------
@app.post("/api/v1/auth/signup", status_code=status.HTTP_201_CREATED)
def signup(body: SignupRequest):
    global next_user_id

    # 중복 이메일 검사
    for user in users_db.values():
        if user["email"] == body.email:
            raise HTTPException(status_code=400, detail="이미 존재하는 이메일입니다.")

    # 새 유저 생성 (기본 권한: 대기자)
    new_user = {
        "id": next_user_id,
        "email": body.email,
        "password": body.password,
        "name": body.name,
        "department": body.department,
        "gender": body.gender,
        "phone_number": body.phone_number,
        "role": "대기자",
        "is_active": True,
    }
    
    users_db[next_user_id] = new_user
    next_user_id += 1

    return {
        "message": "회원가입이 완료되었습니다.",
        "user": {
            "id": new_user["id"],
            "email": new_user["email"],
            "name": new_user["name"],
            "department": new_user["department"],
            "role": new_user["role"],
        }
    }


# ----------------------------------------------------
# 2. 로그인 API (REQ-USER-002)
# ----------------------------------------------------
@app.post("/api/v1/auth/login")
def login(body: LoginRequest):
    # 이메일과 비밀번호가 일치하는 유저 찾기
    matched_user = None
    for user in users_db.values():
        if user["email"] == body.email and user["password"] == body.password:
            matched_user = user
            break

    if not matched_user:
        raise HTTPException(status_code=401, detail="이메일 또는 비밀번호가 일치하지 않습니다.")

    return {
        "access_token": "sample-jwt-token-string",
        "token_type": "bearer",
        "expires_in": 1800,
        "user": {
            "id": matched_user["id"],
            "email": matched_user["email"],
            "name": matched_user["name"],
            "role": matched_user["role"],
        }
    }


# ----------------------------------------------------
# 3. 로그아웃 API (REQ-USER-003)
# ----------------------------------------------------
@app.post("/api/v1/auth/logout")
def logout():
    return {"message": "로그아웃되었습니다."}


# ----------------------------------------------------
# 4. 전체 회원 목록 조회 API (REQ-USER-004) - 어드민 전용
# ----------------------------------------------------
@app.get("/api/v1/admin/users")
def get_user_list(
    query: str | None = None,
    department: str | None = None
):
    result = list(users_db.values())

    # 검색어(이메일 또는 이름) 필터
    if query:
        result = [u for u in result if query in u["email"] or query in u["name"]]

    # 부서 필터
    if department:
        result = [u for u in result if u["department"] == department]

    return result


# ----------------------------------------------------
# 5. 회원 권한 변경 API (REQ-USER-005) - 어드민 전용
# ----------------------------------------------------
@app.patch("/api/v1/admin/users/{user_id}/role")
def update_user_role(user_id: int, body: RoleUpdateRequest):
    if user_id not in users_db:
        raise HTTPException(status_code=404, detail="해당 사용자를 찾을 수 없습니다.")

    # 권한 수정 (대기자, 스태프, 어드민)
    users_db[user_id]["role"] = body.role

    return {
        "id": user_id,
        "role": users_db[user_id]["role"],
        "message": "회원 권한이 성공적으로 수정되었습니다."
    }


# ----------------------------------------------------
# 6. 마이페이지 내 정보 조회 API (REQ-USER-006)
# ----------------------------------------------------
@app.get("/api/v1/users/me")
def get_my_profile():
    # 실습용으로 1번 유저 정보를 조회한다고 가정
    my_info = users_db[1]
    return {
        "id": my_info["id"],
        "name": my_info["name"],
        "email": my_info["email"],
        "department": my_info["department"],
        "gender": my_info["gender"],
        "phone_number": my_info["phone_number"],
        "role": my_info["role"],
    }


# ----------------------------------------------------
# 7. 마이페이지 정보 수정 API (REQ-USER-007)
# ----------------------------------------------------
@app.patch("/api/v1/users/me")
def update_my_profile(body: UserUpdateRequest):
    my_info = users_db[1]

    # 값이 들어온 것만 골라서 수정
    if body.department is not None:
        my_info["department"] = body.department
    if body.phone_number is not None:
        my_info["phone_number"] = body.phone_number

    return {
        "id": my_info["id"],
        "name": my_info["name"],
        "department": my_info["department"],
        "phone_number": my_info["phone_number"],
        "message": "회원 정보가 수정되었습니다."
    }


# ----------------------------------------------------
# 8. 비밀번호 변경 API (REQ-USER-008)
# ----------------------------------------------------
@app.patch("/api/v1/users/me/password")
def change_password(body: PasswordChangeRequest):
    my_info = users_db[1]

    # 기존 비밀번호 맞는지 확인
    if my_info["password"] != body.old_password:
        raise HTTPException(status_code=400, detail="기존 비밀번호가 일치하지 않습니다.")

    # 새 비밀번호로 교체
    my_info["password"] = body.new_password

    return {"message": "비밀번호가 성공적으로 변경되었습니다."}


# ----------------------------------------------------
# 9. 회원 탈퇴 API (REQ-USER-009)
# ----------------------------------------------------
@app.delete("/api/v1/users/me")
def delete_my_account():
    # 1번 유저를 딕셔너리에서 완전히 삭제
    users_db.pop(1, None)
    return {"message": "회원 탈퇴가 완료되었습니다."}
